<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E2E">

    <!-- Top Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#313244"
        android:gravity="center_vertical"
        android:padding="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sura Engine"
            android:textColor="#89B4FA"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Play"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pause"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnBuild"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Build"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left: Hierarchy -->
        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#313244">
            <com.sura.engine.editor.HierarchyPanel
                android:id="@+id/hierarchyPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Center: Scene/Game view -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:background="#45475A">
                <Button
                    android:id="@+id/tabScene"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Scene"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/tabGame"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Game"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.sura.engine.editor.EngineView
                android:id="@+id/engineView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Bottom console -->
            <com.sura.engine.editor.ConsolePanel
                android:id="@+id/consolePanel"
                android:layout_width="match_parent"
                android:layout_height="120dp" />
        </LinearLayout>

        <!-- Right: Inspector -->
        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#313244">
            <com.sura.engine.editor.InspectorPanel
                android:id="@+id/inspectorPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
