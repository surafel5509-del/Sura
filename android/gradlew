#!/usr/bin/env bash
# Minimal Gradle wrapper shim: delegates to system `gradle` if available.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
else
  echo "Gradle not found in PATH. Please install Gradle or run the build with system Gradle." >&2
  exit 1
fi
